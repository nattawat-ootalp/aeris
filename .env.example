# Aeris — environment template. Copy to .env and fill in.
# .env is gitignored. Reuse the AirSentinel free-tier accounts (user-approved).

# ── Supabase (PostgreSQL 16 + RLS) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ── InfluxDB Cloud (time-series) ──
INFLUXDB_URL=
INFLUXDB_TOKEN=
INFLUXDB_ORG=
INFLUXDB_BUCKET=sensor_data

# ── HiveMQ Cloud (MQTT/TLS) ──
HIVEMQ_HOST=
HIVEMQ_PORT=8883
HIVEMQ_USERNAME=
HIVEMQ_PASSWORD=

# ── Backend / API ──
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=12
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Ingestion security ──
# HMAC secret for HiveMQ webhook (empty = dev mode, logs a warning)
WEBHOOK_SECRET=

# ── Aeris intelligence tunables (see docs/DECISIONS.md; NOT medical thresholds) ──
FRESHNESS_MAX_AGE_SEC=120
PM25_ENV_CAUTION=37.5
PM25_ENV_HIGH=75.0
BASELINE_MIN_SAMPLES=50
PATTERN_MIN_SAMPLES=20
DECISION_COOLDOWN_SEC=1800

# ── Deploy (Render) — set in Render dashboard/CI, not committed ──
RENDER_API_KEY=
RENDER_OWNER_ID=
