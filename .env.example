# Aeris — environment template. Copy to .env and fill in.
# .env is gitignored. Reuse the AirSentinel free-tier accounts (user-approved).

# ── Supabase (PostgreSQL 16 + RLS) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Legacy JWT secret (Project Settings -> API) — lets core-api verify mobile Supabase-Auth
# tokens (email + anonymous) so RLS can key on auth.uid(). Empty = mobile auth disabled.
SUPABASE_JWT_SECRET=

# ── InfluxDB Cloud (time-series) ──
INFLUXDB_URL=
INFLUXDB_TOKEN=
INFLUXDB_ORG=
INFLUXDB_BUCKET=sensor_data

# ── HiveMQ Cloud (MQTT/TLS) ──
HIVEMQ_HOST=
HIVEMQ_PORT=8883
HIVEMQ_USERNAME=
HIVEMQ_PASSWORD=

# ── Backend / API ──
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=12
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Ingestion security ──
# HMAC secret for HiveMQ webhook (empty = dev mode, logs a warning)
WEBHOOK_SECRET=

# ── Aeris intelligence tunables (see docs/DECISIONS.md; NOT medical thresholds) ──
FRESHNESS_MAX_AGE_SEC=120
PM25_ENV_CAUTION=37.5
PM25_ENV_HIGH=75.0
BASELINE_MIN_SAMPLES=50
PATTERN_MIN_SAMPLES=20
DECISION_COOLDOWN_SEC=1800

# ── Deploy (Render) — set in Render dashboard/CI, not committed ──
RENDER_API_KEY=
RENDER_OWNER_ID=

# ── Route exposure simulator (§3) ──
# Where route geometry comes from. The Longdo Map key does NOT include Route Service, so the
# default is OSRM. The public demo server has no SLA and asks that heavy use be self-hosted —
# point this at your own instance for anything beyond a demo.
OSRM_BASE_URL=https://router.project-osrm.org
ROUTE_TIMEOUT_S=20

# ── Monitoring / logging (Grafana Cloud) ──
# All optional. With these unset the app logs to stdout and ships nothing — the same rule
# WEBHOOK_SECRET follows, so a deploy that forgets them degrades instead of failing.
# Both endpoints are plain HTTPS pushes made by the process itself: Render's free plan has no
# room for a Grafana Alloy sidecar.
#   GRAFANA_LOKI_URL      https://logs-prod-XXX.grafana.net/loki/api/v1/push
#   GRAFANA_LOKI_USER     the Loki datasource's numeric user id (Grafana Cloud -> Loki -> Details)
#   GRAFANA_GRAPHITE_URL  https://graphite-prod-XX.grafana.net/graphite/metrics
#   GRAFANA_GRAPHITE_USER the Graphite datasource's numeric user id
#   GRAFANA_API_TOKEN     one Cloud Access Policy token with logs:write + metrics:write
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_GRAPHITE_URL=
GRAFANA_GRAPHITE_USER=
GRAFANA_API_TOKEN=
GRAFANA_SERVICE_NAME=
GRAFANA_ENVIRONMENT=
