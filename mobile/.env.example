# Aeris mobile — copy to .env and fill in. EXPO_PUBLIC_* vars are bundled into the client,
# so only put values here that are safe to ship in the app binary (no service_role keys).

EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Longdo Map key — allow-list localhost + aeris-core-api.onrender.com + app id com.aeris.app
EXPO_PUBLIC_LONGDO_KEY=
