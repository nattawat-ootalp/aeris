# Aeris mobile — copy to .env and fill in. EXPO_PUBLIC_* vars are bundled into the client,
# so only put values here that are safe to ship in the app binary (no service_role keys).

EXPO_PUBLIC_API_BASE_URL=https://aeris-core-api.onrender.com
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Longdo Map key — allow-list localhost + aeris-core-api.onrender.com + app id com.aeris.app.
# Left empty the map renders an explicit "key not configured" notice instead of a broken map.
EXPO_PUBLIC_LONGDO_KEY=
# Optional. Empty = fall back to the backend's top-ranked live node (no station id is hardcoded).
EXPO_PUBLIC_DEFAULT_DEVICE_ID=
