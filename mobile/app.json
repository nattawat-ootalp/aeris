{
  "expo": {
    "name": "NextAir",
    "slug": "aeris",
    "version": "1.4.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "aeris",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aeris.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "NextAir connects to your NextAir Portable device over Bluetooth to read live air-quality readings.",
        "NSBluetoothPeripheralUsageDescription": "NextAir connects to your NextAir Portable device over Bluetooth to read live air-quality readings.",
        "NSLocationWhenInUseUsageDescription": "NextAir uses your location to assess environmental conditions near you and at destinations you check."
      }
    },
    "android": {
      "package": "com.aeris.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F8FA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Allow NextAir to connect to your NextAir Portable device over Bluetooth."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6e5a1bf6-5e7d-47c0-98dc-95f1c8f09935"
      }
    }
  }
}
